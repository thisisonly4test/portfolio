{
  "name": "aurele-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio d'aurele : un faux système Linux dans le navigateur (BIOS, GRUB, boot noyau, login, bureau, terminal).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
